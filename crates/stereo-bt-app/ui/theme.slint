// Color and size tokens for JOPL-StereoBT's dark navy look.

export global Theme {
    // Slightly translucent so the Mica backdrop tints through.
    out property <brush> background: #0b0e1ad9;
    out property <brush> card: #121628;
    out property <brush> card-hover: #161b31;
    out property <brush> border: #232a42;
    out property <brush> text: #e7e9f3;
    out property <brush> text-muted: #8b91ab;
    out property <brush> track: #262c45;
    out property <color> accent: #7c3aed;
    out property <color> accent-light: #a78bfa;
    out property <color> info: #3b82f6;
    out property <color> good: #22c55e;
    out property <color> warning: #f59e0b;
    out property <color> error: #f43f5e;
    out property <brush> gradient: @linear-gradient(90deg, #6326ea 0%, #4c6ef0 55%, #3b9be8 100%);
    out property <length> radius: 10px;
    out property <length> small-radius: 6px;
}
