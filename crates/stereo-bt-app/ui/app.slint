// JOPL-StereoBT main window: dark navy cards with a purple/blue accent.
// Standard widgets (scroll bars, About panel) use the Fluent dark style (build.rs).

import { AboutSlint, ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { AccentCheckBox, AccentSlider, GradientButton, OutlineButton, Pill, Segmented, SmallButton } from "controls.slint";

export struct DeviceRow {
    id: string,
    name: string,
    is-source: bool,
    checked: bool,
    can-make-default: bool,
    subtitle: string,
    // Empty when the card shows no badge.
    badge: string,
    // 0 info, 1 good, 2 neutral, 3 warning, 4 error
    badge-kind: int,
    // 0 stereo, 1 left only, 2 right only, 3 mono mix
    mode: int,
    delay: float,
    volume: float,
}

// Volume, delay and channel controls of one target device.
component DeviceControls inherits GridLayout {
    in property <DeviceRow> device;
    callback mode-changed(int);
    callback delay-changed(float);
    callback volume-changed(float);

    // User interaction replaces a control's value binding, so push
    // external changes (e.g. saved settings) in explicitly.
    changed device => {
        volume-slider.value = device.volume;
        delay-slider.value = device.delay;
        mode-picker.current = device.mode;
    }

    spacing-horizontal: 12px;
    spacing-vertical: 6px;
    Row {
        Text {
            text: "Vol";
            color: Theme.text-muted;
            font-size: 13px;
            vertical-alignment: center;
            min-width: 48px;
        }
        volume-slider := AccentSlider {
            minimum: 0;
            maximum: 100;
            value: device.volume;
            label: "Volume for " + device.name;
            changed(value) => { root.volume-changed(value); }
        }
        Text {
            text: round(device.volume);
            color: Theme.accent-light;
            font-size: 13px;
            horizontal-alignment: right;
            vertical-alignment: center;
            min-width: 52px;
        }
    }
    Row {
        Text {
            text: "Delay";
            color: Theme.text-muted;
            font-size: 13px;
            vertical-alignment: center;
        }
        delay-slider := AccentSlider {
            minimum: 0;
            maximum: 500;
            value: device.delay;
            label: "Delay in milliseconds for " + device.name;
            changed(value) => { root.delay-changed(value); }
        }
        Text {
            text: round(device.delay) + " ms";
            color: Theme.info;
            font-size: 13px;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
    }
    Row {
        Text {
            text: "Channel";
            color: Theme.text-muted;
            font-size: 13px;
            vertical-alignment: center;
        }
        mode-picker := Segmented {
            colspan: 2;
            options: ["Stereo", "Left", "Right", "Mono"];
            current: device.mode;
            label: "Channels for " + device.name;
            selected(mode) => { root.mode-changed(mode); }
        }
    }
}

component DeviceCard inherits Rectangle {
    in property <DeviceRow> device;
    callback checked-changed(bool);
    callback make-default();
    callback mode-changed(int);
    callback delay-changed(float);
    callback volume-changed(float);

    border-radius: Theme.radius;
    background: Theme.card;
    border-width: 1px;
    border-color: Theme.border;

    HorizontalLayout {
        padding: 18px;
        spacing: 16px;
        VerticalLayout {
            alignment: center;
            AccentCheckBox {
                checked: device.checked;
                label: device.is-source ? "Keep " + device.name + " playing" : "Play on " + device.name;
                toggled(on) => { root.checked-changed(on); }
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 4px;
            horizontal-stretch: 1;
            Text {
                text: device.name;
                color: Theme.text;
                font-size: 15px;
                font-weight: 600;
                overflow: elide;
            }
            Text {
                text: device.subtitle;
                color: Theme.text-muted;
                font-size: 13px;
                overflow: elide;
            }
            if device.can-make-default: HorizontalLayout {
                alignment: start;
                padding-top: 4px;
                SmallButton {
                    text: "Make default";
                    label: "Make " + device.name + " the Windows default device";
                    clicked => { root.make-default(); }
                }
            }
        }
        if device.badge != "": VerticalLayout {
            alignment: center;
            Pill {
                text: device.badge;
                kind: device.badge-kind;
            }
        }
        if !device.is-source: DeviceControls {
            width: 330px;
            device: root.device;
            mode-changed(mode) => { root.mode-changed(mode); }
            delay-changed(value) => { root.delay-changed(value); }
            volume-changed(value) => { root.volume-changed(value); }
        }
    }
}

export component MainWindow inherits Window {
    title: "JOPL-StereoBT — Every device, in sync";
    icon: @image-url("icon.png");
    background: Theme.background;
    min-width: 760px;
    preferred-width: 940px;
    min-height: 520px;
    preferred-height: 740px;
    default-font-size: 14px;

    in property <[DeviceRow]> devices;
    in property <bool> running;
    in property <string> status-line;
    // 0 idle, 1 streaming, 2 waiting
    in property <int> status-kind;
    in property <string> error-text;
    in property <string> version;
    in property <bool> follow-system-volume;
    // Current Windows volume, e.g. "45 %"; empty when not following.
    in property <string> system-volume-text;

    callback toggle-running();
    callback follow-system-volume-changed(bool);
    callback checked-changed(string, bool);
    callback make-default(string);
    callback mode-changed(string, int);
    callback delay-changed(string, float);
    callback volume-changed(string, float);

    about-popup := PopupWindow {
        x: (root.width - 380px) / 2;
        y: 100px;
        width: 380px;
        Rectangle {
            background: Theme.card;
            border-radius: Theme.radius;
            border-width: 1px;
            border-color: Theme.border;
            VerticalLayout {
                padding: 20px;
                spacing: 10px;
                Text {
                    text: "JOPL-StereoBT " + root.version;
                    color: Theme.text;
                    font-size: 18px;
                    font-weight: 700;
                }
                Text {
                    text: "Play system audio on several devices at once, in sync.\nMIT licence · © 2026 JOPL, Triffit\nInspired by WaveSync.";
                    color: Theme.text-muted;
                    wrap: word-wrap;
                }
                AboutSlint { }
            }
        }
    }

    VerticalLayout {
        padding: 34px;
        padding-top: 30px;
        padding-bottom: 18px;
        spacing: 18px;

        HorizontalLayout {
            spacing: 16px;
            Rectangle {
                width: 52px;
                height: 52px;
                border-radius: 12px;
                background: Theme.gradient;
                Image {
                    source: @image-url("icon.png");
                    width: 34px;
                    height: 34px;
                }
            }
            VerticalLayout {
                alignment: center;
                spacing: 2px;
                horizontal-stretch: 1;
                Text {
                    text: "JOPL-StereoBT";
                    color: Theme.text;
                    font-size: 26px;
                    font-weight: 700;
                }
                Text {
                    text: "Every device, in sync.";
                    color: Theme.text-muted;
                }
            }
            VerticalLayout {
                alignment: center;
                OutlineButton {
                    text: "About";
                    clicked => { about-popup.show(); }
                }
            }
        }

        Rectangle {
            height: 50px;
            border-radius: Theme.radius;
            background: Theme.card;
            border-width: 1px;
            border-color: Theme.border;
            HorizontalLayout {
                padding-left: 18px;
                padding-right: 18px;
                spacing: 12px;
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 9px;
                        height: 9px;
                        border-radius: 4.5px;
                        background: root.status-kind == 1 ? Theme.good : root.status-kind == 2 ? Theme.warning : Theme.info;
                    }
                }
                Text {
                    text: root.status-line;
                    color: Theme.text-muted;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                VerticalLayout {
                    alignment: center;
                    AccentCheckBox {
                        checked: root.follow-system-volume;
                        label: "Follow system volume";
                        toggled(on) => { root.follow-system-volume-changed(on); }
                    }
                }
                Text {
                    text: "Follow system volume";
                    color: Theme.text;
                    vertical-alignment: center;
                }
                if root.system-volume-text != "": Text {
                    text: root.system-volume-text;
                    color: Theme.accent-light;
                    vertical-alignment: center;
                    min-width: 40px;
                    horizontal-alignment: right;
                }
            }
        }

        ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                spacing: 12px;
                alignment: start;
                // Keep cards clear of the vertical scroll bar.
                padding-right: 14px;
                for row in root.devices: DeviceCard {
                    device: row;
                    checked-changed(on) => { root.checked-changed(row.id, on); }
                    make-default => { root.make-default(row.id); }
                    mode-changed(mode) => { root.mode-changed(row.id, mode); }
                    delay-changed(value) => { root.delay-changed(row.id, value); }
                    volume-changed(value) => { root.volume-changed(row.id, value); }
                }
                if root.devices.length == 0: Text {
                    text: "No output devices found.";
                    color: Theme.text-muted;
                    horizontal-alignment: center;
                }
            }
        }

        GradientButton {
            text: root.running ? "Stop multi-output" : "Start multi-output";
            clicked => { root.toggle-running(); }
        }

        Text {
            text: root.error-text != "" ? root.error-text : root.running ? "Streaming" : "Idle";
            color: root.error-text != "" ? Theme.error : Theme.text-muted;
            font-size: 13px;
            wrap: word-wrap;
        }
    }
}

// Shown instead of the main window when the audio engine cannot start.
export component ErrorWindow inherits Window {
    title: "JOPL-StereoBT";
    background: Theme.background;
    in property <string> message;
    callback close-requested();
    VerticalLayout {
        padding: 24px;
        spacing: 14px;
        Text {
            text: "JOPL-StereoBT could not start";
            color: Theme.text;
            font-size: 18px;
            font-weight: 700;
        }
        Text {
            text: root.message;
            color: Theme.text-muted;
            wrap: word-wrap;
        }
        OutlineButton {
            text: "Close";
            clicked => { root.close-requested(); }
        }
    }
}
