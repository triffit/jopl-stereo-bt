// JOPL-StereoBT main window: a Windows 11 app with a navigation rail and
// three pages (Devices, Sync, Settings). Standard widgets (scroll bars,
// About panel) use the Fluent dark style (build.rs).

import { AboutSlint } from "std-widgets.slint";
import { Theme } from "theme.slint";

// Rust sets the accent colour.
export { Theme }
import { Card, CommandButton, PageScrollBar, Dot, Icon, InfoBar, NavItem, Segmented, Slider, SubtleButton, ToggleSwitch } from "controls.slint";

export struct DeviceRow {
    id: string,
    name: string,
    is-source: bool,
    checked: bool,
    can-make-default: bool,
    // Headphones, earbuds or a headset (picks the icon).
    worn: bool,
    // Section title shown above this card; empty for none.
    heading: string,
    // Battery level, e.g. "30 %", and its icon; empty when not reported.
    battery: string,
    battery-glyph: string,
    battery-low: bool,
    // 0 front, 1 center, 2 rear
    position: int,
    collapsed: bool,
    // The main settings in a few words, shown while collapsed.
    summary: string,
    status: string,
    // 0 neutral, 1 good, 2 caution, 3 error
    tone: int,
    // 0 stereo, 1 left only, 2 right only, 3 mono mix
    mode: int,
    delay: float,
    volume: float,
    // Bass cut slider position: 30 means off.
    bass-cut: float,
    virtual-bass: float,
    max-volume: float,
}

// One lane of the timing overview, in milliseconds.
export struct Lane {
    name: string,
    own: float,
    delay: float,
    plays: float,
    is-source: bool,
    in-sync: bool,
}

// What the sync assistant shows; phase 0 measuring, 1 results, 2 fine-tune.
export struct AssistantState {
    active: bool,
    phase: int,
    step: int,
    steps: int,
    device: string,
    is-source: bool,
    taps: int,
    taps-wanted: int,
    can-next: bool,
}

export struct AssistantResult {
    name: string,
    text: string,
    warning: bool,
}

// Microphone measurement; phase 0 running, 1 result, 2 failed.
export struct MeasureState {
    active: bool,
    phase: int,
    // Progress, advice or failure text.
    text: string,
    can-apply: bool,
}

component SectionTitle inherits Text {
    color: Theme.text;
    font-size: 14px;
    font-weight: 600;
}

component Description inherits Text {
    color: Theme.text-3;
    font-size: 11px;
    wrap: word-wrap;
}

component Separator inherits Rectangle {
    height: 1px;
    background: Theme.stroke;
}

// Icon, title and description on the left; children on the right.
component CardHeader inherits HorizontalLayout {
    in property <string> glyph;
    in property <string> title;
    in property <string> description;
    padding-left: 16px;
    padding-right: 16px;
    padding-top: 8px;
    padding-bottom: 8px;
    spacing: 16px;
    min-height: 52px;
    Icon {
        glyph: root.glyph;
        font-size: 18px;
        width: 24px;
    }
    VerticalLayout {
        alignment: center;
        spacing: 2px;
        horizontal-stretch: 1;
        Text {
            text: root.title;
            color: Theme.text;
            wrap: word-wrap;
        }
        if root.description != "": Description {
            text: root.description;
        }
    }
    @children
}

// A labelled slider with its value, e.g. "Delay  [----o--]  41 ms".
component LabeledSlider inherits VerticalLayout {
    in property <string> title;
    in property <string> label;
    in property <string> value-text;
    in property <float> minimum: 0;
    in property <float> maximum: 100;
    in property <bool> enabled: true;
    in-out property <float> value;
    callback changed(float);

    spacing: 0;
    horizontal-stretch: 1;
    Description {
        text: root.title;
        color: Theme.text-2;
    }
    HorizontalLayout {
        spacing: 12px;
        Slider {
            minimum: root.minimum;
            maximum: root.maximum;
            value <=> root.value;
            enabled: root.enabled;
            label: root.label;
            changed(value) => { root.changed(value); }
        }
        Text {
            text: root.value-text;
            color: root.enabled ? Theme.text : Theme.text-3;
            horizontal-alignment: right;
            vertical-alignment: center;
            min-width: 52px;
        }
    }
}

// Every setting of one playing device: channels, delay and volume, then
// the sound row for small speakers (bass cut, virtual bass, speaker limit).
component DeviceControls inherits VerticalLayout {
    in property <DeviceRow> device;
    // The speaker volume limit only acts while following the system volume.
    in property <bool> following;
    callback mode-changed(int);
    callback position-changed(int);
    callback delay-changed(float);
    callback volume-changed(float);
    callback bass-cut-changed(float);
    callback virtual-bass-changed(float);
    callback max-volume-changed(float);

    // User interaction replaces a control's value binding, so push
    // external changes (e.g. applied measurements) in explicitly.
    changed device => {
        volume-slider.value = device.volume;
        delay-slider.value = device.delay;
        mode-picker.current = device.mode;
        position-picker.current = device.position;
        bass-slider.value = device.bass-cut;
        virtual-bass-slider.value = device.virtual-bass;
        max-volume-slider.value = device.max-volume;
    }

    padding-left: 56px;
    padding-right: 16px;
    padding-top: 4px;
    padding-bottom: 10px;
    spacing: 4px;
    // A grid, so both rows share their columns.
    GridLayout {
        spacing-horizontal: 24px;
        spacing-vertical: 6px;
        Row {
            VerticalLayout {
                spacing: 6px;
                Description {
                    text: "Channels";
                    color: Theme.text-2;
                }
                mode-picker := Segmented {
                    options: ["Stereo", "Left", "Right", "Mono"];
                    current: device.mode;
                    label: "Channels for " + device.name;
                    selected(mode) => { root.mode-changed(mode); }
                }
            }
            VerticalLayout {
                spacing: 6px;
                Description {
                    text: "Position";
                    color: Theme.text-2;
                }
                position-picker := Segmented {
                    options: ["Front", "Center", "Rear"];
                    current: device.position;
                    label: "Surround position of " + device.name;
                    selected(position) => { root.position-changed(position); }
                }
            }
            delay-slider := LabeledSlider {
                title: "Delay";
                label: "Delay in milliseconds for " + device.name;
                minimum: 0;
                maximum: 500;
                value: device.delay;
                value-text: round(self.value) + " ms";
                changed(value) => { root.delay-changed(value); }
            }
            volume-slider := LabeledSlider {
                title: "Volume";
                label: "Volume for " + device.name;
                value: device.volume;
                value-text: round(self.value);
                changed(value) => { root.volume-changed(value); }
            }
        }
        Row {
            // The lowest slider position means off (below the 40 Hz minimum).
            bass-slider := LabeledSlider {
                title: "Bass cut";
                label: "Bass cut in hertz for " + device.name + "; lowest position is off";
                minimum: 30;
                maximum: 300;
                value: device.bass-cut;
                value-text: self.value < 40 ? "Off" : round(self.value) + " Hz";
                changed(value) => { root.bass-cut-changed(value); }
            }
            virtual-bass-slider := LabeledSlider {
                title: "Virtual bass";
                label: "Virtual bass in percent for " + device.name;
                value: device.virtual-bass;
                value-text: self.value < 1 ? "Off" : round(self.value) + " %";
                changed(value) => { root.virtual-bass-changed(value); }
            }
            max-volume-slider := LabeledSlider {
                colspan: 2;
                title: root.following ? "Speaker volume limit" : "Speaker volume limit (with Follow system volume)";
                label: "Speaker volume limit in percent for " + device.name + (root.following ? "" : "; only used while following the system volume");
                enabled: root.following;
                value: device.max-volume;
                value-text: round(self.value) + " %";
                changed(value) => { root.max-volume-changed(value); }
            }
        }
    }
}

// Stereo width and reverb for every device played through the app.
component SpaceCard inherits Card {
    in property <float> width-percent;
    in property <float> reverb;
    in property <float> room-size;
    callback width-changed(float);
    callback reverb-changed(float);
    callback room-size-changed(float);

    VerticalLayout {
        CardHeader {
            glyph: "\u{E8B9}";
            title: "Space";
            description: "Wider stereo makes a speaker pair sound further apart; reverb adds a room. Applies to every device played through the app; the default device plays as is.";
        }
        Separator { }
        HorizontalLayout {
            padding-left: 56px;
            padding-right: 16px;
            padding-top: 6px;
            padding-bottom: 10px;
            spacing: 28px;
            LabeledSlider {
                width: 220px;
                title: "Stereo width";
                label: "Stereo width in percent; 100 is unchanged, 0 is mono";
                maximum: 200;
                value: root.width-percent;
                value-text: round(self.value) == 100 ? "Normal" : round(self.value) + " %";
                changed(value) => { root.width-changed(value); }
            }
            reverb-slider := LabeledSlider {
                title: "Reverb";
                label: "Reverb in percent";
                value: root.reverb;
                value-text: self.value < 1 ? "Off" : round(self.value) + " %";
                changed(value) => { root.reverb-changed(value); }
            }
            LabeledSlider {
                title: "Room size";
                label: "Reverb room size in percent";
                enabled: reverb-slider.value >= 1;
                value: root.room-size;
                value-text: round(self.value) + " %";
                changed(value) => { root.room-size-changed(value); }
            }
        }
    }
}

component DeviceCard inherits Card {
    in property <DeviceRow> device;
    // Level meter fill in percent; negative hides the meter.
    in property <int> level: -1;
    callback ping();
    callback position-changed(int);
    callback collapsed-changed(bool);
    in property <bool> following;
    callback bass-cut-changed(float);
    callback virtual-bass-changed(float);
    callback max-volume-changed(float);
    callback checked-changed(bool);
    callback make-default();
    callback mode-changed(int);
    callback delay-changed(float);
    callback volume-changed(float);

    VerticalLayout {
        HorizontalLayout {
            padding-left: 16px;
            padding-right: 16px;
            padding-top: 8px;
            padding-bottom: 8px;
            spacing: 16px;
            min-height: 52px;
            Icon {
                glyph: device.worn ? "\u{E7F6}" : "\u{E7F5}";
                font-size: 18px;
                width: 24px;
            }
            VerticalLayout {
                alignment: center;
                spacing: 2px;
                horizontal-stretch: 1;
                Text {
                    text: device.name;
                    color: Theme.text;
                    overflow: elide;
                }
                if root.level >= 0: Rectangle {
                    height: 4px;
                    width: 160px;
                    border-radius: 2px;
                    background: Theme.control-stroke;
                    accessible-role: progress-indicator;
                    accessible-label: "Level of " + device.name;
                    accessible-value: root.level + " %";
                    Rectangle {
                        x: 0;
                        width: parent.width * clamp(root.level, 0, 100) / 100;
                        border-radius: 2px;
                        background: root.level > 97 ? Theme.caution : Theme.accent;
                    }
                }
                HorizontalLayout {
                    spacing: 6px;
                    VerticalLayout {
                        alignment: center;
                        Dot {
                            tone: device.tone;
                        }
                    }
                    if device.collapsed && device.checked && !device.is-source: Text {
                        text: device.summary;
                        font-size: 12px;
                        color: Theme.text-2;
                    }
                    Text {
                        text: device.status;
                        font-size: 12px;
                        color: device.tone == 2 ? Theme.caution : device.tone == 3 ? Theme.error : Theme.text-3;
                        // Errors explain what to do, so show them in full.
                        wrap: device.tone == 3 ? word-wrap : no-wrap;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                }
            }
            if device.battery != "": HorizontalLayout {
                spacing: 6px;
                accessible-role: text;
                accessible-label: "Battery " + device.battery;
                Icon {
                    glyph: device.battery-glyph;
                    color: device.battery-low ? Theme.caution : Theme.text-2;
                }
                Text {
                    text: device.battery;
                    color: device.battery-low ? Theme.caution : Theme.text-2;
                    vertical-alignment: center;
                }
            }
            // A level meter means the device is playing, so it can be pinged.
            if root.level >= 0: VerticalLayout {
                alignment: center;
                SubtleButton {
                    text: "Ping";
                    label: "Ping " + device.name + ": play a short double beep on it";
                    clicked => { root.ping(); }
                }
            }
            if device.can-make-default: VerticalLayout {
                alignment: center;
                SubtleButton {
                    text: "Make default";
                    label: "Make " + device.name + " the Windows default device";
                    clicked => { root.make-default(); }
                }
            }
            if device.checked && !device.is-source: VerticalLayout {
                alignment: center;
                SubtleButton {
                    glyph: device.collapsed ? "\u{E70D}" : "\u{E70E}";
                    label: (device.collapsed ? "Show all settings of " : "Show only the header of ") + device.name;
                    clicked => { root.collapsed-changed(!device.collapsed); }
                }
            }
            VerticalLayout {
                alignment: center;
                ToggleSwitch {
                    text: device.is-source ? "Keep playing" : device.checked ? "On" : "Off";
                    label: device.is-source ? "Keep " + device.name + " playing" : "Play on " + device.name;
                    checked: device.checked;
                    toggled(on) => { root.checked-changed(on); }
                }
            }
        }
        if device.checked && !device.is-source && !device.collapsed: Separator { }
        if device.checked && !device.is-source && !device.collapsed: DeviceControls {
            device: root.device;
            position-changed(position) => { root.position-changed(position); }
            following: root.following;
            bass-cut-changed(value) => { root.bass-cut-changed(value); }
            virtual-bass-changed(value) => { root.virtual-bass-changed(value); }
            max-volume-changed(value) => { root.max-volume-changed(value); }
            mode-changed(mode) => { root.mode-changed(mode); }
            delay-changed(value) => { root.delay-changed(value); }
            volume-changed(value) => { root.volume-changed(value); }
        }
    }
}

// When each device is heard, against the default device's line.
component Timeline inherits Card {
    in property <[Lane]> lanes;
    in property <[int]> ticks;
    in property <float> scale;
    in property <float> reference;
    property <length> name-width: 200px;
    property <length> value-width: 64px;

    accessible-role: list;
    accessible-label: "When each device plays";

    VerticalLayout {
        padding: 16px;
        padding-top: 12px;
        if root.lanes.length == 0: Description {
            text: "Measure with the microphone to see when each device plays.";
            font-size: 14px;
        }
        if root.lanes.length > 0: HorizontalLayout {
            spacing: 12px;
            Rectangle {
                width: root.name-width;
            }
            Rectangle {
                height: 20px;
                horizontal-stretch: 1;
                for tick in root.ticks: Text {
                    x: parent.width * (tick / root.scale) - self.width / 2;
                    width: 48px;
                    text: tick == 0 ? "0 ms" : tick;
                    font-size: 11px;
                    color: Theme.text-3;
                    horizontal-alignment: center;
                }
            }
            Rectangle {
                width: root.value-width;
            }
        }
        for lane in root.lanes: HorizontalLayout {
            spacing: 12px;
            height: 40px;
            accessible-role: list-item;
            accessible-label: lane.name + ": " + round(lane.plays) + " milliseconds" + (lane.is-source ? ", default device" : lane.in-sync ? ", in sync" : ", out of sync");
            Text {
                width: root.name-width;
                text: lane.name;
                color: Theme.text;
                vertical-alignment: center;
                overflow: elide;
            }
            Rectangle {
                horizontal-stretch: 1;
                // Axis line.
                Rectangle {
                    y: (parent.height - self.height) / 2;
                    height: 2px;
                    background: Theme.control-stroke;
                }
                // Our added delay, after the device's own latency.
                Rectangle {
                    x: parent.width * (lane.own / root.scale);
                    y: (parent.height - self.height) / 2;
                    width: parent.width * (lane.delay / root.scale);
                    height: 6px;
                    border-radius: 3px;
                    background: Theme.accent.with-alpha(0.45);
                }
                // The default device's line.
                Rectangle {
                    x: parent.width * (root.reference / root.scale);
                    width: 1px;
                    background: Theme.text-2;
                }
                Rectangle {
                    x: parent.width * (lane.plays / root.scale) - self.width / 2;
                    y: (parent.height - self.height) / 2;
                    width: 12px;
                    height: 12px;
                    border-radius: 6px;
                    background: lane.is-source ? Theme.text : lane.in-sync ? Theme.accent : Theme.caution;
                }
            }
            Text {
                width: root.value-width;
                text: round(lane.plays) + " ms";
                color: lane.is-source || lane.in-sync ? Theme.text-2 : Theme.caution;
                horizontal-alignment: right;
                vertical-alignment: center;
            }
        }
    }
}

// Measurement progress and result inside the Measure card.
component MeasureDetails inherits VerticalLayout {
    in property <MeasureState> state;
    in property <[string]> lines;
    callback apply();
    callback close();

    padding-left: 56px;
    padding-right: 16px;
    padding-top: 12px;
    padding-bottom: 16px;
    spacing: 8px;
    Text {
        text: root.state.phase == 0 ? "Measuring" : root.state.phase == 1 ? "Result" : "Measurement stopped";
        color: Theme.text;
        font-weight: 600;
    }
    if root.state.phase == 0: Description {
        text: "Each device plays short sweeps in turn while the microphone listens. Keep quiet and pause other audio.";
    }
    for line in root.lines: Text {
        text: line;
        color: Theme.text-2;
        wrap: word-wrap;
    }
    Text {
        text: root.state.text;
        color: root.state.phase == 2 ? Theme.caution : Theme.text;
        wrap: word-wrap;
    }
    HorizontalLayout {
        spacing: 8px;
        alignment: start;
        if root.state.can-apply: CommandButton {
            text: "Apply the measured delays";
            primary: true;
            clicked => { root.apply(); }
        }
        CommandButton {
            text: root.state.phase == 0 ? "Cancel" : "Close";
            clicked => { root.close(); }
        }
    }
}

// The tap and results steps of sync by ear, inside its card.
component AssistantDetails inherits VerticalLayout {
    in property <AssistantState> state;
    in property <[AssistantResult]> results;
    callback tap();
    callback next();
    callback restart();
    callback apply();
    callback cancel();

    padding-left: 56px;
    padding-right: 16px;
    padding-top: 12px;
    padding-bottom: 16px;
    spacing: 10px;

    // Space taps while measuring, wherever focus is inside the card.
    keys := FocusScope {
        init => { self.focus(); }
        key-pressed(event) => {
            if (root.state.phase == 0 && event.text == " ") {
                root.tap();
                return accept;
            }
            return reject;
        }
        VerticalLayout {
            spacing: 10px;
            if root.state.phase == 0: VerticalLayout {
                spacing: 10px;
                Text {
                    text: "Step " + root.state.step + " of " + root.state.steps + ": listen to " + root.state.device;
                    color: Theme.text;
                    font-weight: 600;
                    wrap: word-wrap;
                }
                Description {
                    text: (root.state.is-source
                        ? "Only the default device plays clicks now; the others are aligned to it."
                        : "Only this device plays clicks now.")
                        + " Press Space or Tap each time you hear a click.";
                }
                CommandButton {
                    height: 88px;
                    text: "Tap";
                    font-size: 20px;
                    primary: true;
                    clicked => { root.tap(); }
                }
                Text {
                    text: "Taps: " + root.state.taps + " of " + root.state.taps-wanted;
                    color: root.state.taps >= root.state.taps-wanted ? Theme.success : Theme.text-2;
                    horizontal-alignment: center;
                }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    CommandButton {
                        text: root.state.step < root.state.steps ? "Next device" : "Show results";
                        primary: true;
                        enabled: root.state.can-next;
                        clicked => { root.next(); }
                    }
                    CommandButton {
                        text: "Start over";
                        clicked => { root.restart(); }
                    }
                    CommandButton {
                        text: "Cancel";
                        clicked => { root.cancel(); }
                    }
                }
            }
            if root.state.phase == 1: VerticalLayout {
                spacing: 8px;
                Text {
                    text: "Suggested delays";
                    color: Theme.text;
                    font-weight: 600;
                }
                Description {
                    text: "Measured against the default device. After applying, all devices click together so you can fine-tune on the Devices page.";
                }
                for result in root.results: HorizontalLayout {
                    spacing: 12px;
                    Text {
                        text: result.name;
                        color: Theme.text;
                        min-width: 220px;
                        overflow: elide;
                    }
                    Text {
                        text: result.text;
                        color: result.warning ? Theme.caution : Theme.text-2;
                        wrap: word-wrap;
                        horizontal-stretch: 1;
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    CommandButton {
                        text: "Apply and fine-tune";
                        primary: true;
                        clicked => { root.apply(); }
                    }
                    CommandButton {
                        text: "Cancel";
                        clicked => { root.cancel(); }
                    }
                }
            }
        }
    }
}

// A setting with a toggle switch.
component SettingCard inherits Card {
    in property <string> glyph;
    in property <string> title;
    in property <string> description;
    in property <bool> checked;
    callback toggled(bool);
    CardHeader {
        glyph: root.glyph;
        title: root.title;
        description: root.description;
        VerticalLayout {
            alignment: center;
            ToggleSwitch {
                text: root.checked ? "On" : "Off";
                label: root.title;
                checked: root.checked;
                toggled(on) => { root.toggled(on); }
            }
        }
    }
}

export component MainWindow inherits Window {
    title: "JOPL-StereoBT";
    icon: @image-url("icon.png");
    background: Theme.window;
    min-width: 980px;
    preferred-width: 1120px;
    min-height: 560px;
    preferred-height: 800px;
    default-font-size: 13px;

    in property <[DeviceRow]> devices;
    in property <bool> running;
    // "Active" or "Off", and what is happening.
    in property <string> status-word;
    in property <string> status-message;
    // 0 idle, 1 streaming, 2 waiting
    in property <int> status-kind;
    in property <string> error-text;
    in property <string> version;
    in property <bool> include-default;
    in property <bool> follow-system-volume;
    in property <bool> keep-streaming-on-close;
    // Current Windows volume, e.g. "45 %"; empty when not following.
    in property <string> system-volume-text;
    in property <AssistantState> assistant;
    in property <[AssistantResult]> assistant-results;
    in property <MeasureState> measure;
    in property <[string]> measure-lines;
    // Warning about an app muted on the default device; empty when none.
    in property <string> muted-app-text;
    in property <int> muted-app-pid;
    in property <[Lane]> lanes;
    in property <[int]> lane-ticks;
    in property <float> lane-scale: 100;
    in property <float> lane-reference;
    // The microphone of the last measurement; empty when none counts.
    in property <string> measured-with;
    in property <bool> out-of-sync;

    // 0 Devices, 1 Sync, 2 Settings
    in-out property <int> page;

    callback toggle-running();
    callback include-default-changed(bool);
    callback follow-system-volume-changed(bool);
    callback keep-streaming-changed(bool);
    callback unmute-app(int);
    callback measure-start();
    callback measure-apply();
    callback measure-close();
    callback assistant-start();
    callback assistant-tap();
    callback assistant-next();
    callback assistant-restart();
    callback assistant-apply();
    callback assistant-close();
    callback checked-changed(string, bool);
    callback make-default(string);
    callback mode-changed(string, int);
    callback delay-changed(string, float);
    callback volume-changed(string, float);
    callback bass-cut-changed(string, float);
    callback virtual-bass-changed(string, float);
    callback max-volume-changed(string, float);
    // Level meter fill per device row; negative while not playing.
    in property <[int]> levels;
    callback ping(string);
    callback position-changed(string, int);
    callback collapsed-changed(string, bool);
    in property <float> stereo-width: 100;
    in property <float> reverb;
    in property <float> room-size: 50;
    callback stereo-width-changed(float);
    callback reverb-changed(float);
    callback room-size-changed(float);

    property <bool> busy: root.assistant.active || root.measure.active;

    // Fine-tuning happens with the delay sliders.
    changed assistant => {
        if (root.assistant.active && root.assistant.phase == 2) {
            root.page = 0;
        }
    }

    HorizontalLayout {
        // Navigation rail.
        VerticalLayout {
            width: 260px;
            padding: 6px;
            padding-top: 8px;
            padding-bottom: 8px;
            spacing: 4px;
            accessible-role: tab-list;
            accessible-label: "Pages";
            NavItem {
                glyph: "\u{E7F5}";
                text: "Devices";
                selected: root.page == 0;
                clicked => { root.page = 0; }
            }
            NavItem {
                glyph: "\u{E895}";
                text: "Sync";
                badge: root.out-of-sync;
                selected: root.page == 1;
                clicked => { root.page = 1; }
            }
            Rectangle {
                vertical-stretch: 1;
            }
            NavItem {
                glyph: "\u{E713}";
                text: "Settings";
                selected: root.page == 2;
                clicked => { root.page = 2; }
            }
        }

        // Content.
        Rectangle {
            horizontal-stretch: 1;

            page-flick := Flickable {
                // Wrap long texts instead of scrolling sideways.
                content-width: self.width;
                content-height: page-content.preferred-height;
                page-content := VerticalLayout {
                    width: page-flick.width;
                    padding-left: 36px;
                    padding-right: 36px;
                    padding-top: 18px;
                    padding-bottom: 18px;
                    spacing: 6px;
                    alignment: start;

                    HorizontalLayout {
                        spacing: 16px;
                        padding-bottom: 8px;
                        Text {
                            text: root.page == 0 ? "Devices" : root.page == 1 ? "Sync" : "Settings";
                            color: Theme.text;
                            font-size: 24px;
                            font-weight: 600;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        VerticalLayout {
                            alignment: center;
                            CommandButton {
                                height: 32px;
                                text: root.running ? "Stop playing" : "Play on multiple devices";
                                glyph: root.running ? "\u{E71A}" : "\u{E768}";
                                primary: !root.running;
                                font-size: 15px;
                                clicked => { root.toggle-running(); }
                            }
                        }
                    }

                    InfoBar {
                        tone: root.status-kind == 1 ? 1 : root.status-kind == 2 ? 2 : 0;
                        title: root.status-word;
                        message: root.status-message;
                    }
                    if root.error-text != "": InfoBar {
                        tone: 3;
                        title: "Error";
                        message: root.error-text;
                    }
                    if root.muted-app-text != "": InfoBar {
                        tone: 2;
                        title: "";
                        message: root.muted-app-text;
                        VerticalLayout {
                            alignment: center;
                            CommandButton {
                                text: "Unmute";
                                clicked => { root.unmute-app(root.muted-app-pid); }
                            }
                        }
                    }

                    // Devices page.
                    if root.page == 0 && root.assistant.active && root.assistant.phase == 2: InfoBar {
                        tone: 0;
                        title: "Fine-tune";
                        message: "Every device clicks together now. Move each Delay until the clicks sound like one. Still late at 0 ms? Make the slowest device the default.";
                        VerticalLayout {
                            alignment: center;
                            CommandButton {
                                text: "Done";
                                primary: true;
                                clicked => { root.assistant-close(); }
                            }
                        }
                    }
                    if root.page == 0: VerticalLayout {
                        spacing: 6px;
                        for row[index] in root.devices: VerticalLayout {
                        spacing: 6px;
                        if row.heading != "": SectionTitle {
                            text: row.heading;
                            height: 28px;
                            vertical-alignment: bottom;
                        }
                        DeviceCard {
                            device: row;
                            level: index < root.levels.length ? root.levels[index] : -1;
                            ping => { root.ping(row.id); }
                            position-changed(position) => { root.position-changed(row.id, position); }
                            collapsed-changed(collapsed) => { root.collapsed-changed(row.id, collapsed); }
                            checked-changed(on) => { root.checked-changed(row.id, on); }
                            make-default => { root.make-default(row.id); }
                            mode-changed(mode) => { root.mode-changed(row.id, mode); }
                            delay-changed(value) => { root.delay-changed(row.id, value); }
                            volume-changed(value) => { root.volume-changed(row.id, value); }
                            following: root.follow-system-volume;
                            bass-cut-changed(value) => { root.bass-cut-changed(row.id, value); }
                            virtual-bass-changed(value) => { root.virtual-bass-changed(row.id, value); }
                            max-volume-changed(value) => { root.max-volume-changed(row.id, value); }
                        }
                        }
                        if root.devices.length == 0: Description {
                            text: "No output devices found.";
                            font-size: 14px;
                        }
                        SectionTitle {
                            text: "Sound";
                            height: 28px;
                            vertical-alignment: bottom;
                        }
                        SpaceCard {
                            width-percent: root.stereo-width;
                            reverb: root.reverb;
                            room-size: root.room-size;
                            width-changed(value) => { root.stereo-width-changed(value); }
                            reverb-changed(value) => { root.reverb-changed(value); }
                            room-size-changed(value) => { root.room-size-changed(value); }
                        }
                    }

                    // Sync page.
                    if root.page == 1: VerticalLayout {
                    spacing: 6px;
                    SectionTitle {
                        text: "When each device plays";
                        height: 28px;
                        vertical-alignment: bottom;
                    }
                    Timeline {
                        lanes: root.lanes;
                        ticks: root.lane-ticks;
                        scale: root.lane-scale;
                        reference: root.lane-reference;
                    }
                    SectionTitle {
                        text: "Make them play together";
                        height: 28px;
                        vertical-alignment: bottom;
                    }
                    Card {
                        VerticalLayout {
                            CardHeader {
                                glyph: "\u{E720}";
                                title: "Measure with the microphone";
                                description: root.running
                                    ? "Recommended. Each device plays short sweeps while your microphone listens; takes about 20 seconds."
                                    : "Press Play on multiple devices first.";
                                VerticalLayout {
                                    alignment: center;
                                    CommandButton {
                                        text: "Measure";
                                        primary: true;
                                        enabled: root.running && !root.busy;
                                        clicked => { root.measure-start(); }
                                    }
                                }
                            }
                            if root.measure.active: Separator { }
                            if root.measure.active: MeasureDetails {
                                state: root.measure;
                                lines: root.measure-lines;
                                apply => { root.measure-apply(); }
                                close => { root.measure-close(); }
                            }
                            if !root.measure.active && root.measured-with != "": Separator { }
                            if !root.measure.active && root.measured-with != "": HorizontalLayout {
                                // Aligned with the card title.
                                padding-left: 56px;
                                padding-right: 16px;
                                padding-top: 12px;
                                padding-bottom: 12px;
                                Description {
                                    text: "Last measured with " + root.measured-with + ". The chart above shows the current delays.";
                                    font-size: 14px;
                                    color: Theme.text-2;
                                }
                            }
                        }
                    }
                    Card {
                        VerticalLayout {
                            CardHeader {
                                glyph: "\u{E767}";
                                title: "Sync by ear";
                                description: root.running
                                    ? "Tap along with clicks on each device, then fine-tune until the clicks sound as one."
                                    : "Press Play on multiple devices first.";
                                VerticalLayout {
                                    alignment: center;
                                    CommandButton {
                                        text: "Start";
                                        enabled: root.running && !root.busy;
                                        clicked => { root.assistant-start(); }
                                    }
                                }
                            }
                            if root.assistant.active && root.assistant.phase != 2: Separator { }
                            if root.assistant.active && root.assistant.phase != 2: AssistantDetails {
                                state: root.assistant;
                                results: root.assistant-results;
                                tap => { root.assistant-tap(); }
                                next => { root.assistant-next(); }
                                restart => { root.assistant-restart(); }
                                apply => { root.assistant-apply(); }
                                cancel => { root.assistant-close(); }
                            }
                        }
                    }

                    }

                    // Settings page.
                    if root.page == 2: VerticalLayout {
                    spacing: 6px;
                    SectionTitle {
                        text: "Playback";
                        height: 28px;
                        vertical-alignment: bottom;
                    }
                    SettingCard {
                        glyph: "\u{E7F5}";
                        title: "Keep the default device playing";
                        description: "Off: the default device is muted while playing and only feeds the other devices.";
                        checked: root.include-default;
                        toggled(on) => { root.include-default-changed(on); }
                    }
                    SettingCard {
                        glyph: "\u{E767}";
                        title: "Follow system volume";
                        description: "Every device follows the Windows volume of the default device"
                            + (root.system-volume-text != "" ? " (now " + root.system-volume-text + ")." : ".");
                        checked: root.follow-system-volume;
                        toggled(on) => { root.follow-system-volume-changed(on); }
                    }
                    SettingCard {
                        glyph: "\u{E737}";
                        title: "Keep playing when the window is closed";
                        description: "The app keeps playing from the notification area; quit it from its menu there.";
                        checked: root.keep-streaming-on-close;
                        toggled(on) => { root.keep-streaming-changed(on); }
                    }
                    SectionTitle {
                        text: "About";
                        height: 28px;
                        vertical-alignment: bottom;
                    }
                    Card {
                        VerticalLayout {
                            padding: 16px;
                            spacing: 8px;
                            Text {
                                text: "JOPL-StereoBT " + root.version;
                                color: Theme.text;
                                font-weight: 600;
                            }
                            Description {
                                text: "Plays system audio on several devices at once, in sync.\nMIT licence, © 2026 JOPL, Triffit. Inspired by WaveSync.";
                                font-size: 14px;
                                color: Theme.text-2;
                            }
                            HorizontalLayout {
                                alignment: start;
                                AboutSlint { }
                            }
                        }
                    }
                    }
                }
            }

            // A thin scrollbar as in Windows Settings; wider while pointed at.
            if page-flick.content-height > page-flick.height: PageScrollBar {
                x: parent.width - self.width;
                height: parent.height;
                flick-height: page-flick.height;
                content-height: page-flick.content-height;
                offset <=> page-flick.content-y;
            }
        }
    }
}

// Shown instead of the main window when the audio engine cannot start.
export component ErrorWindow inherits Window {
    title: "JOPL-StereoBT";
    background: Theme.window;
    default-font-size: 13px;
    in property <string> message;
    callback close-requested();
    VerticalLayout {
        padding: 24px;
        spacing: 14px;
        Text {
            text: "JOPL-StereoBT could not start";
            color: Theme.text;
            font-size: 20px;
            font-weight: 600;
        }
        Text {
            text: root.message;
            color: Theme.text-2;
            wrap: word-wrap;
        }
        HorizontalLayout {
            alignment: end;
            CommandButton {
                text: "Close";
                clicked => { root.close-requested(); }
            }
        }
    }
}
