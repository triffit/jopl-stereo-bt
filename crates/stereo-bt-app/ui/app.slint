// JOPL-StereoBT main window: dark navy cards with a purple/blue accent.
// Standard widgets (scroll bars, About panel) use the Fluent dark style (build.rs).

import { AboutSlint, ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { AccentCheckBox, AccentSlider, GradientButton, OutlineButton, Pill, Segmented, SmallButton } from "controls.slint";

export struct DeviceRow {
    id: string,
    name: string,
    is-source: bool,
    checked: bool,
    can-make-default: bool,
    subtitle: string,
    // Empty when the card shows no badge.
    badge: string,
    // 0 info, 1 good, 2 neutral, 3 warning, 4 error
    badge-kind: int,
    // 0 stereo, 1 left only, 2 right only, 3 mono mix
    mode: int,
    delay: float,
    volume: float,
}

// What the sync assistant shows; phase 0 measuring, 1 results, 2 fine-tune.
export struct AssistantState {
    active: bool,
    phase: int,
    step: int,
    steps: int,
    device: string,
    is-source: bool,
    taps: int,
    taps-wanted: int,
    can-next: bool,
}

// Microphone measurement; phase 0 running, 1 result, 2 failed.
export struct MeasureState {
    active: bool,
    phase: int,
    // Progress, advice or failure text.
    text: string,
    can-apply: bool,
}

component MeasurePanel inherits Rectangle {
    in property <MeasureState> state;
    in property <[string]> lines;
    callback apply();
    callback close();

    border-radius: Theme.radius;
    background: Theme.card;
    border-width: 1px;
    border-color: Theme.border;

    VerticalLayout {
        padding: 24px;
        spacing: 12px;
        Text {
            text: root.state.phase == 0 ? "Measuring with the microphone" : root.state.phase == 1 ? "Measurement result" : "Measurement stopped";
            color: Theme.text;
            font-size: 18px;
            font-weight: 700;
        }
        if root.state.phase == 0: Text {
            text: "Each device plays short sweeps in turn while the microphone listens. Keep quiet and pause other audio.";
            color: Theme.text-muted;
            wrap: word-wrap;
        }
        for line in root.lines: Text {
            text: line;
            color: Theme.text;
            wrap: word-wrap;
        }
        Text {
            text: root.state.text;
            color: root.state.phase == 2 ? Theme.warning : root.state.phase == 1 ? Theme.accent-light : Theme.text-muted;
            wrap: word-wrap;
        }
        HorizontalLayout {
            spacing: 10px;
            alignment: end;
            if root.state.can-apply: OutlineButton {
                text: "Apply";
                clicked => { root.apply(); }
            }
            OutlineButton {
                text: root.state.phase == 0 ? "Cancel" : "Close";
                clicked => { root.close(); }
            }
        }
        Rectangle {
            vertical-stretch: 1;
        }
    }
}

export struct AssistantResult {
    name: string,
    text: string,
    warning: bool,
}

// Measuring and results steps of the sync assistant.
component AssistantPanel inherits Rectangle {
    in property <AssistantState> state;
    in property <[AssistantResult]> results;
    callback tap();
    callback next();
    callback restart();
    callback apply();
    callback cancel();

    border-radius: Theme.radius;
    background: Theme.card;
    border-width: 1px;
    border-color: Theme.border;

    // Space taps while measuring, wherever focus is inside the panel.
    keys := FocusScope {
        init => { self.focus(); }
        key-pressed(event) => {
            if (root.state.phase == 0 && event.text == " ") {
                root.tap();
                return accept;
            }
            return reject;
        }

        VerticalLayout {
            padding: 24px;
            spacing: 14px;

            if root.state.phase == 0: VerticalLayout {
                spacing: 14px;
                Text {
                    text: "Step " + root.state.step + " of " + root.state.steps + " · Listen to " + root.state.device;
                    color: Theme.text;
                    font-size: 18px;
                    font-weight: 700;
                    wrap: word-wrap;
                }
                Text {
                    text: (root.state.is-source
                        ? "Only the default device plays the clicks now; it is the reference the others are aligned to."
                        : "Only this device plays the clicks now.")
                        + " Press Space or Tap each time you hear a click. Pause other audio for best results.";
                    color: Theme.text-muted;
                    wrap: word-wrap;
                }
                GradientButton {
                    height: 110px;
                    text: "Tap";
                    clicked => { root.tap(); }
                }
                Text {
                    text: "Taps: " + root.state.taps + " / " + root.state.taps-wanted;
                    color: root.state.taps >= root.state.taps-wanted ? Theme.good : Theme.accent-light;
                    font-size: 15px;
                    horizontal-alignment: center;
                }
                HorizontalLayout {
                    spacing: 10px;
                    alignment: end;
                    OutlineButton {
                        text: "Start over";
                        clicked => { root.restart(); }
                    }
                    OutlineButton {
                        text: root.state.step < root.state.steps ? "Next device" : "Show results";
                        enabled: root.state.can-next;
                        clicked => { root.next(); }
                    }
                    OutlineButton {
                        text: "Cancel";
                        clicked => { root.cancel(); }
                    }
                }
            }

            if root.state.phase == 1: VerticalLayout {
                spacing: 12px;
                Text {
                    text: "Suggested delays";
                    color: Theme.text;
                    font-size: 18px;
                    font-weight: 700;
                }
                Text {
                    text: "Measured against the default device. After applying, all devices click together so you can fine-tune by ear.";
                    color: Theme.text-muted;
                    wrap: word-wrap;
                }
                for result in root.results: HorizontalLayout {
                    spacing: 12px;
                    Text {
                        text: result.name;
                        color: Theme.text;
                        font-weight: 600;
                        min-width: 220px;
                        overflow: elide;
                    }
                    Text {
                        text: result.text;
                        color: result.warning ? Theme.warning : Theme.accent-light;
                        wrap: word-wrap;
                        horizontal-stretch: 1;
                    }
                }
                HorizontalLayout {
                    spacing: 10px;
                    alignment: end;
                    OutlineButton {
                        text: "Apply and fine-tune";
                        clicked => { root.apply(); }
                    }
                    OutlineButton {
                        text: "Cancel";
                        clicked => { root.cancel(); }
                    }
                }
            }
            Rectangle {
                vertical-stretch: 1;
            }
        }
    }
}

// Volume, delay and channel controls of one target device.
component DeviceControls inherits GridLayout {
    in property <DeviceRow> device;
    callback mode-changed(int);
    callback delay-changed(float);
    callback volume-changed(float);

    // User interaction replaces a control's value binding, so push
    // external changes (e.g. saved settings) in explicitly.
    changed device => {
        volume-slider.value = device.volume;
        delay-slider.value = device.delay;
        mode-picker.current = device.mode;
    }

    spacing-horizontal: 12px;
    spacing-vertical: 6px;
    Row {
        Text {
            text: "Vol";
            color: Theme.text-muted;
            font-size: 13px;
            vertical-alignment: center;
            min-width: 48px;
        }
        volume-slider := AccentSlider {
            minimum: 0;
            maximum: 100;
            value: device.volume;
            label: "Volume for " + device.name;
            changed(value) => { root.volume-changed(value); }
        }
        Text {
            text: round(device.volume);
            color: Theme.accent-light;
            font-size: 13px;
            horizontal-alignment: right;
            vertical-alignment: center;
            min-width: 52px;
        }
    }
    Row {
        Text {
            text: "Delay";
            color: Theme.text-muted;
            font-size: 13px;
            vertical-alignment: center;
        }
        delay-slider := AccentSlider {
            minimum: 0;
            maximum: 500;
            value: device.delay;
            label: "Delay in milliseconds for " + device.name;
            changed(value) => { root.delay-changed(value); }
        }
        Text {
            text: round(device.delay) + " ms";
            color: Theme.info;
            font-size: 13px;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
    }
    Row {
        Text {
            text: "Channel";
            color: Theme.text-muted;
            font-size: 13px;
            vertical-alignment: center;
        }
        mode-picker := Segmented {
            colspan: 2;
            options: ["Stereo", "Left", "Right", "Mono"];
            current: device.mode;
            label: "Channels for " + device.name;
            selected(mode) => { root.mode-changed(mode); }
        }
    }
}

component DeviceCard inherits Rectangle {
    in property <DeviceRow> device;
    callback checked-changed(bool);
    callback make-default();
    callback mode-changed(int);
    callback delay-changed(float);
    callback volume-changed(float);

    border-radius: Theme.radius;
    background: Theme.card;
    border-width: 1px;
    border-color: Theme.border;

    HorizontalLayout {
        padding: 18px;
        spacing: 16px;
        VerticalLayout {
            alignment: center;
            AccentCheckBox {
                checked: device.checked;
                label: device.is-source ? "Keep " + device.name + " playing" : "Play on " + device.name;
                toggled(on) => { root.checked-changed(on); }
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 4px;
            horizontal-stretch: 1;
            Text {
                text: device.name;
                color: Theme.text;
                font-size: 15px;
                font-weight: 600;
                overflow: elide;
            }
            Text {
                text: device.subtitle;
                color: Theme.text-muted;
                font-size: 13px;
                overflow: elide;
            }
            if device.can-make-default: HorizontalLayout {
                alignment: start;
                padding-top: 4px;
                SmallButton {
                    text: "Make default";
                    label: "Make " + device.name + " the Windows default device";
                    clicked => { root.make-default(); }
                }
            }
        }
        if device.badge != "": VerticalLayout {
            alignment: center;
            Pill {
                text: device.badge;
                kind: device.badge-kind;
            }
        }
        if !device.is-source: DeviceControls {
            width: 330px;
            device: root.device;
            mode-changed(mode) => { root.mode-changed(mode); }
            delay-changed(value) => { root.delay-changed(value); }
            volume-changed(value) => { root.volume-changed(value); }
        }
    }
}

export component MainWindow inherits Window {
    title: "JOPL-StereoBT — Every device, in sync";
    icon: @image-url("icon.png");
    background: Theme.background;
    min-width: 760px;
    preferred-width: 940px;
    min-height: 520px;
    preferred-height: 740px;
    default-font-size: 14px;

    in property <[DeviceRow]> devices;
    in property <bool> running;
    in property <string> status-line;
    // 0 idle, 1 streaming, 2 waiting
    in property <int> status-kind;
    in property <string> error-text;
    in property <string> version;
    in property <bool> follow-system-volume;
    in property <AssistantState> assistant;
    // Warning about an app muted on the default device; empty when none.
    in property <string> muted-app-text;
    in property <int> muted-app-pid;
    in property <[AssistantResult]> assistant-results;
    in property <MeasureState> measure;
    in property <[string]> measure-lines;
    // Current Windows volume, e.g. "45 %"; empty when not following.
    in property <string> system-volume-text;

    callback toggle-running();
    callback follow-system-volume-changed(bool);
    callback unmute-app(int);
    callback measure-start();
    callback measure-apply();
    callback measure-close();
    callback assistant-start();
    callback assistant-tap();
    callback assistant-next();
    callback assistant-restart();
    callback assistant-apply();
    callback assistant-close();
    callback checked-changed(string, bool);
    callback make-default(string);
    callback mode-changed(string, int);
    callback delay-changed(string, float);
    callback volume-changed(string, float);

    about-popup := PopupWindow {
        x: (root.width - 380px) / 2;
        y: 100px;
        width: 380px;
        Rectangle {
            background: Theme.card;
            border-radius: Theme.radius;
            border-width: 1px;
            border-color: Theme.border;
            VerticalLayout {
                padding: 20px;
                spacing: 10px;
                Text {
                    text: "JOPL-StereoBT " + root.version;
                    color: Theme.text;
                    font-size: 18px;
                    font-weight: 700;
                }
                Text {
                    text: "Play system audio on several devices at once, in sync.\nMIT licence · © 2026 JOPL, Triffit\nInspired by WaveSync.";
                    color: Theme.text-muted;
                    wrap: word-wrap;
                }
                AboutSlint { }
            }
        }
    }

    VerticalLayout {
        padding: 34px;
        padding-top: 30px;
        padding-bottom: 18px;
        spacing: 18px;

        HorizontalLayout {
            spacing: 16px;
            Rectangle {
                width: 52px;
                height: 52px;
                border-radius: 12px;
                background: Theme.gradient;
                Image {
                    source: @image-url("icon.png");
                    width: 34px;
                    height: 34px;
                }
            }
            VerticalLayout {
                alignment: center;
                spacing: 2px;
                horizontal-stretch: 1;
                Text {
                    text: "JOPL-StereoBT";
                    color: Theme.text;
                    font-size: 26px;
                    font-weight: 700;
                }
                Text {
                    text: "Every device, in sync.";
                    color: Theme.text-muted;
                }
            }
            VerticalLayout {
                alignment: center;
                HorizontalLayout {
                    spacing: 10px;
                    OutlineButton {
                        text: "Measure with mic";
                        enabled: root.running && !root.assistant.active && !root.measure.active;
                        clicked => { root.measure-start(); }
                    }
                    OutlineButton {
                        text: "Sync assistant";
                        enabled: root.running && !root.assistant.active && !root.measure.active;
                        clicked => { root.assistant-start(); }
                    }
                    OutlineButton {
                        text: "About";
                        clicked => { about-popup.show(); }
                    }
                }
            }
        }

        Rectangle {
            height: 50px;
            border-radius: Theme.radius;
            background: Theme.card;
            border-width: 1px;
            border-color: Theme.border;
            HorizontalLayout {
                padding-left: 18px;
                padding-right: 18px;
                spacing: 12px;
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 9px;
                        height: 9px;
                        border-radius: 4.5px;
                        background: root.status-kind == 1 ? Theme.good : root.status-kind == 2 ? Theme.warning : Theme.info;
                    }
                }
                Text {
                    text: root.status-line;
                    color: Theme.text-muted;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                VerticalLayout {
                    alignment: center;
                    AccentCheckBox {
                        checked: root.follow-system-volume;
                        label: "Follow system volume";
                        toggled(on) => { root.follow-system-volume-changed(on); }
                    }
                }
                Text {
                    text: "Follow system volume";
                    color: Theme.text;
                    vertical-alignment: center;
                }
                if root.system-volume-text != "": Text {
                    text: root.system-volume-text;
                    color: Theme.accent-light;
                    vertical-alignment: center;
                    min-width: 40px;
                    horizontal-alignment: right;
                }
            }
        }

        if root.muted-app-text != "": Rectangle {
            border-radius: Theme.radius;
            background: Theme.warning.with-alpha(0.12);
            border-width: 1px;
            border-color: Theme.warning;
            HorizontalLayout {
                padding: 12px;
                spacing: 14px;
                Text {
                    text: root.muted-app-text;
                    color: Theme.text;
                    wrap: word-wrap;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                VerticalLayout {
                    alignment: center;
                    OutlineButton {
                        text: "Unmute";
                        clicked => { root.unmute-app(root.muted-app-pid); }
                    }
                }
            }
        }

        if root.assistant.active && root.assistant.phase == 2: Rectangle {
            border-radius: Theme.radius;
            background: Theme.accent.with-alpha(0.14);
            border-width: 1px;
            border-color: Theme.accent;
            HorizontalLayout {
                padding: 14px;
                spacing: 14px;
                Text {
                    text: "Fine-tune: every device clicks together now. Adjust each Delay until the clicks sound like one. A device that is still late at 0 ms: make the slowest device the default.";
                    color: Theme.text;
                    wrap: word-wrap;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                VerticalLayout {
                    alignment: center;
                    OutlineButton {
                        text: "Done";
                        clicked => { root.assistant-close(); }
                    }
                }
            }
        }

        if root.measure.active: MeasurePanel {
            vertical-stretch: 1;
            state: root.measure;
            lines: root.measure-lines;
            apply => { root.measure-apply(); }
            close => { root.measure-close(); }
        }

        if root.assistant.active && root.assistant.phase != 2: AssistantPanel {
            vertical-stretch: 1;
            state: root.assistant;
            results: root.assistant-results;
            tap => { root.assistant-tap(); }
            next => { root.assistant-next(); }
            restart => { root.assistant-restart(); }
            apply => { root.assistant-apply(); }
            cancel => { root.assistant-close(); }
        }

        if !root.measure.active && (!root.assistant.active || root.assistant.phase == 2): ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                spacing: 12px;
                alignment: start;
                // Keep cards clear of the vertical scroll bar.
                padding-right: 14px;
                for row in root.devices: DeviceCard {
                    device: row;
                    checked-changed(on) => { root.checked-changed(row.id, on); }
                    make-default => { root.make-default(row.id); }
                    mode-changed(mode) => { root.mode-changed(row.id, mode); }
                    delay-changed(value) => { root.delay-changed(row.id, value); }
                    volume-changed(value) => { root.volume-changed(row.id, value); }
                }
                if root.devices.length == 0: Text {
                    text: "No output devices found.";
                    color: Theme.text-muted;
                    horizontal-alignment: center;
                }
            }
        }

        GradientButton {
            text: root.running ? "Stop multi-output" : "Start multi-output";
            clicked => { root.toggle-running(); }
        }

        Text {
            text: root.error-text != "" ? root.error-text : root.running ? "Streaming" : "Idle";
            color: root.error-text != "" ? Theme.error : Theme.text-muted;
            font-size: 13px;
            wrap: word-wrap;
        }
    }
}

// Shown instead of the main window when the audio engine cannot start.
export component ErrorWindow inherits Window {
    title: "JOPL-StereoBT";
    background: Theme.background;
    in property <string> message;
    callback close-requested();
    VerticalLayout {
        padding: 24px;
        spacing: 14px;
        Text {
            text: "JOPL-StereoBT could not start";
            color: Theme.text;
            font-size: 18px;
            font-weight: 700;
        }
        Text {
            text: root.message;
            color: Theme.text-muted;
            wrap: word-wrap;
        }
        OutlineButton {
            text: "Close";
            clicked => { root.close-requested(); }
        }
    }
}
