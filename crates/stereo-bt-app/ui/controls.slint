// Custom-drawn controls in the accent style. Each one is keyboard operable
// and exposes an accessible role, label and value to screen readers.

import { Theme } from "theme.slint";

// Thin focus outline drawn around a focused control.
component FocusRing inherits Rectangle {
    in property <bool> shown;
    border-radius: Theme.small-radius;
    border-width: shown ? 2px : 0;
    border-color: Theme.accent-light;
}

export component AccentSlider inherits Rectangle {
    in property <float> minimum: 0;
    in property <float> maximum: 100;
    // in-out: the user moves it; owners push external changes back in.
    in-out property <float> value;
    in property <string> label;
    callback changed(float);

    property <length> knob: 16px;
    property <float> ratio: (root.value - root.minimum) / (root.maximum - root.minimum);

    function set(v: float) {
        root.value = clamp(round(v), root.minimum, root.maximum);
        root.changed(root.value);
    }

    function set-from-x(x: length) {
        root.set(root.minimum + (x - root.knob / 2) / (root.width - root.knob) * (root.maximum - root.minimum));
    }

    min-height: 24px;
    horizontal-stretch: 1;
    accessible-role: slider;
    accessible-label: root.label;
    accessible-value: round(root.value);
    accessible-value-minimum: root.minimum;
    accessible-value-maximum: root.maximum;
    accessible-value-step: 1;
    accessible-action-increment => { root.set(root.value + 1); }
    accessible-action-decrement => { root.set(root.value - 1); }

    focus := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.RightArrow || event.text == Key.UpArrow) {
                root.set(root.value + 1);
                return accept;
            }
            if (event.text == Key.LeftArrow || event.text == Key.DownArrow) {
                root.set(root.value - 1);
                return accept;
            }
            if (event.text == Key.PageUp) {
                root.set(root.value + 10);
                return accept;
            }
            if (event.text == Key.PageDown) {
                root.set(root.value - 10);
                return accept;
            }
            if (event.text == Key.Home) {
                root.set(root.minimum);
                return accept;
            }
            if (event.text == Key.End) {
                root.set(root.maximum);
                return accept;
            }
            return reject;
        }

        track := Rectangle {
            x: root.knob / 2;
            y: (parent.height - 4px) / 2;
            width: parent.width - root.knob;
            height: 4px;
            border-radius: 2px;
            background: Theme.track;
        }

        Rectangle {
            x: track.x;
            y: track.y;
            width: track.width * root.ratio;
            height: 4px;
            border-radius: 2px;
            background: Theme.accent;
        }

        Rectangle {
            x: track.x + track.width * root.ratio - root.knob / 2;
            y: (parent.height - root.knob) / 2;
            width: root.knob;
            height: root.knob;
            border-radius: root.knob / 2;
            background: #ffffff;
            border-width: 3px;
            border-color: focus.has-focus || touch.pressed ? Theme.accent-light : Theme.accent;
        }

        touch := TouchArea {
            mouse-cursor: pointer;
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                    focus.focus();
                    root.set-from-x(self.mouse-x);
                }
            }
            moved => {
                if (self.pressed) {
                    root.set-from-x(self.mouse-x);
                }
            }
        }
    }
}

export component AccentCheckBox inherits Rectangle {
    in property <bool> checked;
    in property <string> label;
    callback toggled(bool);

    width: 22px;
    height: 22px;
    accessible-role: checkbox;
    accessible-label: root.label;
    accessible-checkable: true;
    accessible-checked: root.checked;
    accessible-action-default => { root.toggled(!root.checked); }

    box := Rectangle {
        border-radius: 5px;
        background: root.checked ? Theme.accent : transparent;
        border-width: root.checked ? 0 : 2px;
        border-color: touch.has-hover ? Theme.accent-light : Theme.text-muted;
    }

    if root.checked: Path {
        width: 100%;
        height: 100%;
        viewbox-width: 22;
        viewbox-height: 22;
        commands: "M 5.5 11.5 L 9.5 15.5 L 16.5 7.5";
        stroke: #ffffff;
        stroke-width: 2.5px;
    }

    focus := FocusScope {
        key-pressed(event) => {
            if (event.text == " " || event.text == Key.Return) {
                root.toggled(!root.checked);
                return accept;
            }
            return reject;
        }
        touch := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                focus.focus();
                root.toggled(!root.checked);
            }
        }
    }

    FocusRing {
        x: -3px;
        y: -3px;
        width: parent.width + 6px;
        height: parent.height + 6px;
        shown: focus.has-focus;
    }
}

// Small rounded status label. kind: 0 info, 1 good, 2 neutral, 3 warning, 4 error.
export component Pill inherits Rectangle {
    in property <string> text;
    in property <int> kind;
    property <color> tint: kind == 0 ? Theme.info : kind == 1 ? Theme.accent-light : kind == 3 ? Theme.warning : kind == 4 ? Theme.error : #9aa0b8;

    height: 24px;
    border-radius: 7px;
    background: root.tint.with-alpha(0.16);
    horizontal-stretch: 0;
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        Text {
            text: root.text;
            color: root.tint;
            font-size: 12px;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
}

// Choice between a few short options, e.g. the channel mode.
export component Segmented inherits Rectangle {
    in property <[string]> options;
    in-out property <int> current;
    in property <string> label;
    callback selected(int);

    height: 26px;
    border-radius: Theme.small-radius;
    background: Theme.track;
    accessible-role: tab-list;
    accessible-label: root.label;

    focus := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.RightArrow && root.current < root.options.length - 1) {
                root.current += 1;
                root.selected(root.current);
                return accept;
            }
            if (event.text == Key.LeftArrow && root.current > 0) {
                root.current -= 1;
                root.selected(root.current);
                return accept;
            }
            return reject;
        }
        HorizontalLayout {
            padding: 2px;
            spacing: 2px;
            for option[index] in root.options: Rectangle {
                horizontal-stretch: 1;
                border-radius: Theme.small-radius - 2px;
                background: index == root.current ? Theme.accent : segment-touch.has-hover ? Theme.border : transparent;
                accessible-role: tab;
                accessible-label: option;
                accessible-item-selected: index == root.current;
                accessible-action-default => {
                    root.current = index;
                    root.selected(index);
                }
                Text {
                    text: option;
                    font-size: 12px;
                    color: index == root.current ? #ffffff : Theme.text-muted;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                segment-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        focus.focus();
                        root.current = index;
                        root.selected(index);
                    }
                }
            }
        }
    }

    FocusRing {
        x: -3px;
        y: -3px;
        width: parent.width + 6px;
        height: parent.height + 6px;
        shown: focus.has-focus;
    }
}

export component OutlineButton inherits Rectangle {
    in property <string> text;
    callback clicked();

    height: 40px;
    min-width: 120px;
    border-radius: 8px;
    background: touch.has-hover ? Theme.card-hover : Theme.card;
    border-width: 1px;
    border-color: focus.has-focus ? Theme.accent-light : Theme.border;
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { root.clicked(); }

    focus := FocusScope {
        key-pressed(event) => {
            if (event.text == " " || event.text == Key.Return) {
                root.clicked();
                return accept;
            }
            return reject;
        }
        touch := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                focus.focus();
                root.clicked();
            }
        }
    }
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        Text {
            text: root.text;
            color: Theme.text;
            font-size: 14px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

// Compact secondary action, e.g. "Make default" on a device card.
export component SmallButton inherits Rectangle {
    in property <string> text;
    in property <string> label: root.text;
    callback clicked();

    height: 26px;
    border-radius: Theme.small-radius;
    background: touch.has-hover ? Theme.card-hover : transparent;
    border-width: 1px;
    border-color: focus.has-focus ? Theme.accent-light : Theme.border;
    horizontal-stretch: 0;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }

    focus := FocusScope {
        key-pressed(event) => {
            if (event.text == " " || event.text == Key.Return) {
                root.clicked();
                return accept;
            }
            return reject;
        }
        touch := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                focus.focus();
                root.clicked();
            }
        }
    }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        Text {
            text: root.text;
            color: Theme.text-muted;
            font-size: 12px;
            vertical-alignment: center;
        }
    }
}

export component GradientButton inherits Rectangle {
    in property <string> text;
    callback clicked();

    height: 58px;
    border-radius: Theme.radius;
    background: Theme.gradient;
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { root.clicked(); }

    // Hover and press feedback without changing the gradient itself.
    Rectangle {
        border-radius: Theme.radius;
        background: touch.pressed ? #00000033 : touch.has-hover ? #ffffff14 : transparent;
        border-width: focus.has-focus ? 2px : 0;
        border-color: #ffffffaa;
    }
    focus := FocusScope {
        key-pressed(event) => {
            if (event.text == " " || event.text == Key.Return) {
                root.clicked();
                return accept;
            }
            return reject;
        }
        touch := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                focus.focus();
                root.clicked();
            }
        }
    }
    Text {
        text: root.text;
        color: #ffffff;
        font-size: 17px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}
