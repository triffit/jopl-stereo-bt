// Windows 11 Fluent-style controls not covered by Slint's std widgets.
// Each one is keyboard operable and exposes an accessible role, label and
// value to screen readers.

import { Theme } from "theme.slint";

// A Segoe Fluent Icons glyph.
export component Icon inherits Text {
    in property <string> glyph;
    text: root.glyph;
    font-family: Theme.icons;
    font-size: 16px;
    color: Theme.text-2;
    vertical-alignment: center;
    horizontal-alignment: center;
    accessible-role: none;
}

// A small status dot; tone 0 neutral, 1 good, 2 caution, 3 error.
export component Dot inherits Rectangle {
    in property <int> tone;
    width: 6px;
    height: 6px;
    border-radius: 3px;
    background: root.tone == 1 ? Theme.success : root.tone == 2 ? Theme.caution : root.tone == 3 ? Theme.error : Theme.text-3;
}

// A card surface.
export component Card inherits Rectangle {
    border-radius: Theme.radius;
    background: Theme.layer;
    border-width: 1px;
    border-color: Theme.stroke;
}

// Horizontal slider with a Fluent thumb.
export component Slider inherits Rectangle {
    in property <float> minimum: 0;
    in property <float> maximum: 100;
    // in-out: the user moves it; owners push external changes back in.
    in-out property <float> value;
    in property <string> label;
    in property <bool> enabled: true;
    callback changed(float);

    property <length> thumb: 20px;
    property <float> ratio: (root.value - root.minimum) / (root.maximum - root.minimum);

    function set(v: float) {
        root.value = clamp(round(v), root.minimum, root.maximum);
        root.changed(root.value);
    }

    function set-from-x(x: length) {
        root.set(root.minimum + (x - root.thumb / 2) / (root.width - root.thumb) * (root.maximum - root.minimum));
    }

    min-height: 32px;
    min-width: 80px;
    horizontal-stretch: 1;
    opacity: root.enabled ? 1 : 0.4;
    accessible-role: slider;
    accessible-enabled: root.enabled;
    accessible-label: root.label;
    accessible-value: round(root.value);
    accessible-value-minimum: root.minimum;
    accessible-value-maximum: root.maximum;
    accessible-value-step: 1;
    accessible-action-increment => { root.set(root.value + 1); }
    accessible-action-decrement => { root.set(root.value - 1); }

    focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if (event.text == Key.RightArrow || event.text == Key.UpArrow) {
                root.set(root.value + 1);
                return accept;
            }
            if (event.text == Key.LeftArrow || event.text == Key.DownArrow) {
                root.set(root.value - 1);
                return accept;
            }
            if (event.text == Key.PageUp) {
                root.set(root.value + 10);
                return accept;
            }
            if (event.text == Key.PageDown) {
                root.set(root.value - 10);
                return accept;
            }
            if (event.text == Key.Home) {
                root.set(root.minimum);
                return accept;
            }
            if (event.text == Key.End) {
                root.set(root.maximum);
                return accept;
            }
            return reject;
        }

        track := Rectangle {
            x: root.thumb / 2;
            y: (parent.height - 4px) / 2;
            width: parent.width - root.thumb;
            height: 4px;
            border-radius: 2px;
            background: Theme.text-3;
        }

        Rectangle {
            x: track.x;
            y: track.y;
            width: track.width * root.ratio;
            height: 4px;
            border-radius: 2px;
            background: Theme.accent;
        }

        Rectangle {
            x: track.x + track.width * root.ratio - root.thumb / 2;
            y: (parent.height - root.thumb) / 2;
            width: root.thumb;
            height: root.thumb;
            border-radius: root.thumb / 2;
            background: #454545;
            border-width: 1px;
            border-color: focus.has-focus ? Theme.text : #ffffff17;
            Rectangle {
                property <length> size: touch.pressed ? 10px : touch.has-hover ? 14px : 12px;
                x: (parent.width - self.size) / 2;
                y: (parent.height - self.size) / 2;
                width: self.size;
                height: self.size;
                border-radius: self.size / 2;
                background: Theme.accent;
                animate size { duration: 80ms; }
            }
        }

        touch := TouchArea {
            enabled: root.enabled;
            mouse-cursor: pointer;
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                    focus.focus();
                    root.set-from-x(self.mouse-x);
                }
            }
            moved => {
                if (self.pressed) {
                    root.set-from-x(self.mouse-x);
                }
            }
        }
    }
}

// Windows toggle switch with an optional visible text to its left.
export component ToggleSwitch inherits Rectangle {
    in property <bool> checked;
    in property <string> text;
    // Accessible name; defaults to the visible text.
    in property <string> label: root.text;
    callback toggled(bool);

    min-height: 32px;
    horizontal-stretch: 0;
    accessible-role: checkbox;
    accessible-label: root.label;
    accessible-checkable: true;
    accessible-checked: root.checked;
    accessible-action-default => { root.toggled(!root.checked); }

    focus := FocusScope {
        key-pressed(event) => {
            if (event.text == " " || event.text == Key.Return) {
                root.toggled(!root.checked);
                return accept;
            }
            return reject;
        }
        touch := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                focus.focus();
                root.toggled(!root.checked);
            }
        }
    }
    HorizontalLayout {
        spacing: 12px;
        alignment: end;
        if root.text != "": Text {
            text: root.text;
            color: Theme.text;
            vertical-alignment: center;
        }
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 40px;
                height: 20px;
                border-radius: 10px;
                background: root.checked ? (touch.has-hover ? Theme.accent-hover : Theme.accent) : (touch.has-hover ? Theme.control : transparent);
                border-width: root.checked ? 0 : 1px;
                border-color: Theme.text-2;
                Rectangle {
                    property <length> size: touch.pressed ? 14px : 12px;
                    x: root.checked ? parent.width - self.size - 4px : 4px;
                    y: (parent.height - self.size) / 2;
                    width: self.size;
                    height: self.size;
                    border-radius: self.size / 2;
                    background: root.checked ? #000000 : Theme.text-2;
                    animate x { duration: 120ms; easing: ease-out; }
                }
                // Focus ring.
                Rectangle {
                    x: -3px;
                    y: -3px;
                    width: parent.width + 6px;
                    height: parent.height + 6px;
                    border-radius: 13px;
                    border-width: focus.has-focus ? 2px : 0;
                    border-color: Theme.text;
                }
            }
        }
    }
}

// Button with an optional icon; `primary` uses the accent colour.
export component CommandButton inherits Rectangle {
    in property <string> text;
    in property <string> glyph;
    in property <bool> primary;
    in property <bool> enabled: true;
    in property <length> font-size: 14px;
    callback clicked();

    height: 32px;
    border-radius: Theme.control-radius;
    background: !root.enabled ? Theme.control
        : root.primary ? (touch.has-hover ? Theme.accent-hover : Theme.accent)
        : (touch.has-hover ? Theme.layer-hover : Theme.control);
    border-width: focus.has-focus ? 2px : root.primary ? 0 : 1px;
    border-color: focus.has-focus ? Theme.text : Theme.control-stroke;
    opacity: root.enabled ? 1 : 0.45;
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if (root.enabled) {
            root.clicked();
        }
    }

    focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if (event.text == " " || event.text == Key.Return) {
                root.clicked();
                return accept;
            }
            return reject;
        }
        touch := TouchArea {
            enabled: root.enabled;
            mouse-cursor: pointer;
            clicked => {
                focus.focus();
                root.clicked();
            }
        }
    }
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 8px;
        alignment: center;
        if root.glyph != "": Icon {
            glyph: root.glyph;
            font-size: 14px;
            color: root.primary && root.enabled ? #000000 : Theme.text;
        }
        Text {
            text: root.text;
            font-size: root.font-size;
            color: root.primary && root.enabled ? #000000 : Theme.text;
            vertical-alignment: center;
        }
    }
}

// Borderless text button, e.g. "Make default" on a device card.
export component SubtleButton inherits Rectangle {
    in property <string> text;
    in property <string> label: root.text;
    callback clicked();

    height: 32px;
    border-radius: Theme.control-radius;
    background: touch.has-hover ? Theme.control : transparent;
    border-width: focus.has-focus ? 2px : 0;
    border-color: Theme.text;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }

    focus := FocusScope {
        key-pressed(event) => {
            if (event.text == " " || event.text == Key.Return) {
                root.clicked();
                return accept;
            }
            return reject;
        }
        touch := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                focus.focus();
                root.clicked();
            }
        }
    }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        Text {
            text: root.text;
            color: Theme.text;
            vertical-alignment: center;
        }
    }
}

// A choice between a few short options, e.g. the channels.
export component Segmented inherits Rectangle {
    in property <[string]> options;
    in-out property <int> current;
    in property <string> label;
    callback selected(int);

    height: 32px;
    border-radius: Theme.control-radius;
    background: Theme.control;
    border-width: focus.has-focus ? 2px : 1px;
    border-color: focus.has-focus ? Theme.text : Theme.control-stroke;
    accessible-role: tab-list;
    accessible-label: root.label;

    focus := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.RightArrow && root.current < root.options.length - 1) {
                root.current += 1;
                root.selected(root.current);
                return accept;
            }
            if (event.text == Key.LeftArrow && root.current > 0) {
                root.current -= 1;
                root.selected(root.current);
                return accept;
            }
            return reject;
        }
        HorizontalLayout {
            padding: 1px;
            for option[index] in root.options: Rectangle {
                horizontal-stretch: 1;
                min-width: 60px;
                background: index == root.current ? #ffffff17 : segment-touch.has-hover ? #ffffff0a : transparent;
                accessible-role: tab;
                accessible-label: option;
                accessible-item-selected: index == root.current;
                accessible-action-default => {
                    root.current = index;
                    root.selected(index);
                }
                if index > 0: Rectangle {
                    x: 0;
                    width: 1px;
                    background: Theme.control-stroke;
                }
                Text {
                    text: option;
                    color: Theme.text;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                if index == root.current: Rectangle {
                    x: (parent.width - self.width) / 2;
                    y: parent.height - 5px;
                    width: 16px;
                    height: 3px;
                    border-radius: 1.5px;
                    background: Theme.accent;
                }
                segment-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        focus.focus();
                        root.current = index;
                        root.selected(index);
                    }
                }
            }
        }
    }
}

// InfoBar; tone 0 neutral, 1 success, 2 caution, 3 error. Children are
// placed at the right end (e.g. an action button).
export component InfoBar inherits Rectangle {
    in property <int> tone;
    in property <string> title;
    in property <string> message;

    border-radius: Theme.control-radius;
    background: root.tone == 1 ? Theme.info-success : root.tone == 2 ? Theme.info-caution : root.tone == 3 ? Theme.info-error : Theme.layer;
    border-width: 1px;
    border-color: Theme.stroke;
    accessible-role: text;
    accessible-label: root.title + ": " + root.message;

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 8px;
        padding-top: 6px;
        padding-bottom: 6px;
        spacing: 12px;
        min-height: 48px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 16px;
                height: 16px;
                border-radius: 8px;
                background: root.tone == 1 ? Theme.success : root.tone == 2 ? Theme.caution : root.tone == 3 ? Theme.error : Theme.text-3;
                Icon {
                    glyph: root.tone == 1 ? "\u{E73E}" : root.tone == 0 ? "\u{E946}" : "\u{E7BA}";
                    font-size: 10px;
                    color: #000000;
                }
            }
        }
        if root.title != "": Text {
            text: root.title;
            font-weight: 600;
            color: Theme.text;
            vertical-alignment: center;
        }
        Text {
            text: root.message;
            color: Theme.text;
            vertical-alignment: center;
            wrap: word-wrap;
            horizontal-stretch: 1;
        }
        @children
    }
}

// A navigation rail item; `badge` shows a yellow attention dot.
export component NavItem inherits Rectangle {
    in property <string> glyph;
    in property <string> text;
    in property <bool> selected;
    in property <bool> badge;
    callback clicked();

    height: 36px;
    border-radius: Theme.control-radius;
    background: root.selected ? Theme.layer : touch.has-hover ? Theme.control : transparent;
    border-width: focus.has-focus ? 2px : 0;
    border-color: Theme.text;
    accessible-role: tab;
    accessible-label: root.badge ? root.text + ", needs attention" : root.text;
    accessible-item-selected: root.selected;
    accessible-action-default => { root.clicked(); }

    if root.selected: Rectangle {
        x: 0;
        y: 10px;
        width: 3px;
        height: parent.height - 20px;
        border-radius: 1.5px;
        background: Theme.accent;
    }
    focus := FocusScope {
        key-pressed(event) => {
            if (event.text == " " || event.text == Key.Return) {
                root.clicked();
                return accept;
            }
            return reject;
        }
        touch := TouchArea {
            mouse-cursor: pointer;
            // No focus on click: the ring is for keyboard users.
            clicked => { root.clicked(); }
        }
    }
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 14px;
        Icon {
            glyph: root.glyph;
            color: Theme.text;
            width: 16px;
        }
        Text {
            text: root.text;
            color: Theme.text;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        if root.badge: VerticalLayout {
            alignment: center;
            Rectangle {
                width: 8px;
                height: 8px;
                border-radius: 4px;
                background: Theme.caution;
            }
        }
    }
}
